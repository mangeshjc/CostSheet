# Every environment variable the app reads. Copy what you need into Render's
# Environment tab (or a local .env, which is git-ignored). Nothing here is
# required locally -- settings.py has working fallbacks for development.

# --- Django ---
# Render generates this automatically via render.yaml. Locally you can skip it.
DJANGO_SECRET_KEY=
# Defaults to False when running on Render, True otherwise.
DJANGO_DEBUG=
# Extra hostnames, comma separated. Render's own hostname is added for you.
DJANGO_ALLOWED_HOSTS=
# Set to e.g. 31536000 to turn on HSTS once your final domain is settled.
DJANGO_HSTS_SECONDS=
# Optional managed database. Without it, an ephemeral sqlite file is used.
DATABASE_URL=

# --- Google credentials ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The whole contents of google_token.json on one line.
# Produce it with:  python manage.py google_token_env
GOOGLE_TOKEN_JSON=

# --- Drive folders / Sheet ids (all optional; settings.py holds defaults) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_ERP_SOURCE_FOLDER_ID=
GOOGLE_ERP_SOURCE_FOLDER_NAME=
GOOGLE_ARTR_OUTPUT_FOLDER_ID=
GOOGLE_HORIZONTAL_CS_SHEET_ID=
GOOGLE_SALES_DASHBOARD_SHEET_ID=
GOOGLE_COSTING_ROOT_FOLDER_ID=
GOOGLE_COSTING_DB_SHEET_ID=
